# AULOS NEWS — HETZNER ENVIRONMENT TEMPLATE
# Copy to .env, replace only values you have, and never commit .env.
# Empty optional keys are safe: their connectors remain disabled or use keyless access.

# CORE INFRASTRUCTURE — REQUIRED
# Generate secrets with: openssl rand -hex 32
POSTGRES_DB=aulos
POSTGRES_USER=aulos
POSTGRES_PASSWORD=replace-with-a-long-random-value
ADMIN_TOKEN=replace-with-a-different-long-random-value
POLL_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=20
MAX_ITEMS_PER_FEED=30
CORS_ORIGINS=https://aulos-news.ian-g-lacey2.chatgpt.site

# LIVE MARKETS + FINANCIAL NEWS — ALPACA
# https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# U.S. MACRO + FIXED INCOME — FREE KEYS
# FRED: https://fred.stlouisfed.org/docs/api/api_key.html
# BLS: https://data.bls.gov/registrationEngine/
# BEA: https://apps.bea.gov/api/signup/
# Census: https://api.census.gov/data/key_signup.html
FRED_API_KEY=
BLS_API_KEY=
BEA_API_KEY=
CENSUS_API_KEY=
# Keyless: Treasury Fiscal Data, NY Fed Markets, SEC EDGAR, World Bank, ECB, BIS.

# ENERGY, OIL, GAS, ELECTRICITY + RENEWABLES — FREE
# https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# SCHOLARLY RESEARCH — FREE / FREE-TIER
# OpenAlex: https://openalex.org/settings/api
# Semantic Scholar: https://www.semanticscholar.org/product/api
# NCBI: https://www.ncbi.nlm.nih.gov/account/settings/
# NASA: https://api.nasa.gov/
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
NCBI_API_KEY=
NASA_API_KEY=
CONTACT_EMAIL=your-email@example.com
# Keyless: Crossref, Europe PMC, arXiv, ClinicalTrials.gov and NIH RePORTER.

# GLOBAL BREAKING NEWS + GEOPOLITICS — OPTIONAL FREE/FREE-TIER
# GDELT is keyless and already connected.
# ACLED: https://acleddata.com/register/
# NewsAPI: https://newsapi.org/register
# GNews: https://gnews.io/register
# Check each provider's display, caching and production-use terms before enabling.
ACLED_API_KEY=
ACLED_EMAIL=
RELIEFWEB_APPNAME=aulos-news
NEWSAPI_API_KEY=
GNEWS_API_KEY=

# ADDITIONAL MARKET / COMMODITY COVERAGE — OPTIONAL FREE-TIER
# Alpha Vantage: https://www.alphavantage.co/support/#api-key
# Finnhub: https://finnhub.io/register
# Twelve Data: https://twelvedata.com/register
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=

# UAP / GOVERNMENT DISCLOSURE
# AARO, ODNI, NASA UAP pages and National Archives RG 615 are public/keyless.
# Government records are documentary evidence, not proof of extraordinary origin.
NARA_CATALOG_API_KEY=

# OPTIONAL FUTURE AI SYNTHESIS — leave blank until citation checks are ready.
OPENAI_API_KEY=

# HOSTED FRONTEND RUNTIME — configured in OpenAI Sites, not required by Docker.
AULOS_BACKEND_URL=http://62.238.119.174
